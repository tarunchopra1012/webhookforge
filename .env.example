# Copy to .env and adjust as needed. src/utils/config.ts is the only file
# that reads process.env directly — everything else imports from there.

NODE_ENV=development
PORT=3000

# Postgres — same names the postgres image in docker-compose.yml expects,
# so one .env drives both the app and local infra.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=webhookforge
POSTGRES_PASSWORD=webhookforge
POSTGRES_DB=webhookforge

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
